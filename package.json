{
  "name": "scrapingdog-mcp",
  "version": "0.1.1",
  "description": "Hosted Model Context Protocol (MCP) server for the Scrapingdog web-scraping and SERP APIs (mcp.scrapingdog.com).",
  "license": "MIT",
  "author": "Scrapingdog",
  "homepage": "https://www.scrapingdog.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darshan972/Scrapingdog-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Darshan972/Scrapingdog-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/http.js",
    "dev": "node --experimental-strip-types src/http.ts",
    "dev:stdio": "node --experimental-strip-types src/index.ts",
    "smoke": "node scripts/smoke.mjs",
    "list:unverified": "node scripts/list-unverified.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scrapingdog",
    "web-scraping",
    "serp"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "private": true
}
