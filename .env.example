# --- Hosted server (mcp.scrapingdog.com) -------------------------------------
# The customer's API key arrives per request in the Authorization header, so the
# hosted server needs NO key of its own.

# Where the MCP server listens. Keep it on loopback in production; nginx proxies.
HOST=127.0.0.1
PORT=8731

# Scrapingdog API this server forwards tool calls to.
SCRAPINGDOG_API_BASE=https://api.scrapingdog.com

# Per-request timeout for a scrape (ms).
SCRAPINGDOG_TIMEOUT_MS=90000

# How long a verified / rejected API key is cached (ms).
MCP_AUTH_POSITIVE_TTL_MS=300000
MCP_AUTH_NEGATIVE_TTL_MS=60000

# --- Local stdio dev only ----------------------------------------------------
# `npm run dev` runs the stdio entry point for testing tools without deploying.
# SCRAPINGDOG_API_KEY=your_api_key_here
